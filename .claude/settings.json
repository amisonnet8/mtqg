{
  "permissions": {
    "deny": ["Bash(git push*)", "Bash(gh pr merge*)", "Bash(gh release create*)"],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(go get*)",
      "Bash(*sudo*)",
      "Bash(gh pr create*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/build.sh"
          }
        ]
      }
    ]
  }
}
