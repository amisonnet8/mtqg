# Built binary (root only: a bare "mtqg" would also ignore cmd/mtqg/)
/mtqg
/mtqg.exe
# Build artifacts (keep binaries out of the repository).
/bin/
/dist/
*.exe
*.test
*.out

# Allowlist for dot entries in the repository root (and .claude/): ignore all
# of them, then re-include only what is tracked. This also covers the dummy
# /dev/null files that the Bash sandbox leaves in the working directory
# (.claude/rules/testing.md). A new tracked dot entry needs a "!" line here.
/.*
!/.gitignore
!/.gitattributes
!/.golangci.yaml
!/.goreleaser.yaml
!/.mcp.json
!/.devcontainer/
!/.github/
!/.mtqg/
# The descriptions of this repository's files (crube, .claude/rules/crube-usage.md).
!/.crube/
# The description of each commit (fnaze, .claude/rules/fnaze-usage.md).
!/.fnaze/
# The git hooks of this repository (core.hooksPath, set by .devcontainer/postCreate.sh).
!/.githooks/

# .claude/: only the shared files (settings.local.json stays personal)
!/.claude/
/.claude/*
!/.claude/settings.json
!/.claude/rules/
!/.claude/skills/
!/.claude/hooks/
