{
  "mcpServers": {
    "mtqg": {
      "args": [
        "mcp"
      ],
      "command": "mtqg",
      "type": "stdio"
    },
    "crube": {
      "command": "crube",
      "args": [
        "mcp",
        "--allow-write"
      ]
    },
    "crube-ja": {
      "command": "crube",
      "args": [
        "mcp",
        "--allow-write"
      ],
      "env": {
        "CRUBE_LANG": "ja"
      }
    },
    "fnaze": {
      "command": "fnaze",
      "args": [
        "mcp",
        "--allow-write"
      ]
    }
  }
}
