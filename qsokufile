# Entry points for building and checking mtqg (.claude/rules/testing.md,
# .claude/rules/qsoku-usage.md). qsoku always runs with sh, so every entry
# works the same no matter which shell called it.

# Compile every package first: a package that cmd/mtqg does not import yet
# would otherwise be skipped, and so would its build errors.
build: (cd //; go build ./... && go build ./cmd/mtqg)

# Rewrite files with the formatters enabled in .golangci.yaml.
fmt: (cd //; golangci-lint fmt)

vet: (cd //; go vet ./... && go vet -tags e2e ./e2e/...)

# Also reports files that the formatters would change. If golangci-lint is older
# than the Go in this container it cannot read the standard library (typecheck
# errors "export data version N is greater than ..."); say what to do about it.
lint: (cd //; if out=$(golangci-lint run 2>&1); then printf '%s\n' "$out"; else printf '%s\n' "$out"; if printf '%s' "$out" | grep -q 'export data version'; then echo "hint: this golangci-lint is older than the Go in this container and cannot read its standard library. Update it: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest (.claude/rules/testing.md)" >&2; fi; false; fi)

unit: (cd //; go test ./...)

# Type-check and lint for the other OSes: the lock (flock / LockFileEx) and the
# terminal files (ansi_*.go, tty_*.go) differ per OS, and a Linux-only run does
# not notice a broken Windows file.
cross: (cd //; rc=0; for os in windows darwin; do echo "== GOOS=$os"; GOOS=$os go vet ./... && GOOS=$os go vet -tags e2e ./e2e/... && GOOS=$os golangci-lint run || rc=1; done; [ "$rc" -eq 0 ])

check: qsoku vet && qsoku lint && qsoku cross && qsoku unit

# End-to-end tests: the real mtqg binary against real git repositories (e2e/,
# built with the tag e2e, so check does not run them).
test: (cd //; go test -tags e2e -count=1 ./e2e/...)

# Write what mtqg prints into the examples of docs/ (e2e/examples_test.go).
# Read the diff: an example that changed is a document that went stale, or a bug.
docs-examples: (cd //; go test -tags e2e -count=1 -run '^TestDocExamples$' ./e2e/... -update)

# -race needs cgo, which the container turns off (.claude/rules/distribution.md).
race: (cd //; CGO_ENABLED=1 go test -race -count=1 ./...)

trivy: (cd //; trivy fs --config trivy.yaml .)

shellcheck: (cd //; git ls-files '*.sh' '*.bash' | xargs -r shellcheck)

# The decision table of the hook that forces commands through bcuz (needs jq).
hook: (cd //; bash .claude/hooks/require-bcuz.test.sh)
